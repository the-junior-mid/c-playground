{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build vector",
      "type": "shell",
      "command": "mkdir -p build && gcc -g -O0 -Wall -Wextra -Iinclude ${workspaceFolder}/tests/test_vector.c -o ${workspaceFolder}/build/test_vector",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "build String",
      "type": "shell",
      "command": "mkdir -p build && gcc -g -O0 -Wall -Wextra -Iinclude ${workspaceFolder}/src/test/test_String.c -o ${workspaceFolder}/build/test_String",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
  ]
}