{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build vector",
      "type": "shell",
      "command": "mkdir -p build && gcc -g -O0 -Wall -Wextra -Iinclude ${workspaceFolder}/tests/test_vector.c ${workspaceFolder}/src/vector.c -o ${workspaceFolder}/build/test_vector",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "build String",
      "type": "shell",
      "command": "mkdir -p build && gcc -g -O0 -Wall -Wextra -Iinclude ${workspaceFolder}/tests/test_String.c ${workspaceFolder}/src/String.c ${workspaceFolder}/src/vector.c -o ${workspaceFolder}/build/test_String",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "build hashmap",
      "type": "shell",
      "command": "mkdir -p build && gcc -g -O0 -Wall -Wextra -Iinclude ${workspaceFolder}/tests/test_hashmap.c ${workspaceFolder}/src/hashmap.c -o ${workspaceFolder}/build/test_hashmap -lm",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "build option",
      "type": "shell",
      "command": "mkdir -p build && gcc -g -O0 -Wall -Wextra -Iinclude ${workspaceFolder}/tests/test_option.c ${workspaceFolder}/src/option.c -o ${workspaceFolder}/build/test_option",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
  ]
}